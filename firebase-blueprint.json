{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "description": "URL to the user's profile picture." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user account was created." }
      },
      "required": ["uid", "email"]
    },
    "Video": {
      "title": "Video",
      "description": "Metadata for an AI-generated video with optional reference and scene images.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the video." },
        "userId": { "type": "string", "description": "UID of the owner." },
        "title": { "type": "string", "maxLength": 200, "description": "Title of the video project." },
        "prompt": { "type": "string", "maxLength": 2000, "description": "The text prompt used to generate the video." },
        "folder": { "type": "string", "maxLength": 100, "description": "Custom folder name for organizing the video." },
        "script": { "type": "string", "maxLength": 10000, "description": "Generated narrative script." },
        "scenes": { "type": "array", "description": "Storyboard scenes with optional imageUrl." },
        "images": { "type": "array", "description": "Compressed data URLs of images used in the video." },
        "referenceImage": { "type": "string", "description": "Primary starting frame or thumbnail image data URL." },
        "scene3dPreset": { "type": "string", "description": "Linked 3D stage scene preset ID." },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"], "description": "Current status of the generation." },
        "videoData": { "type": "string", "description": "Base64 encoded video data or URI." },
        "mimeType": { "type": "string", "description": "MIME type of the video." },
        "aspectRatio": { "type": "string", "description": "Aspect ratio of the video." },
        "duration": { "type": "string", "description": "Duration of the video." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation." },
        "interactionId": { "type": "string", "description": "Gemini Interaction ID for tracking." }
      },
      "required": ["userId", "prompt", "status", "createdAt"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Free business registration directed to https://whop.com/@saulmente with subscription token credits.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the registration." },
        "userId": { "type": "string", "description": "UID of the user or guest identifier." },
        "name": { "type": "string", "maxLength": 120, "description": "Full name of the registrant." },
        "email": { "type": "string", "maxLength": 256, "description": "Email address of the registrant." },
        "businessName": { "type": "string", "maxLength": 160, "description": "Business, brand, or project name." },
        "phone": { "type": "string", "maxLength": 60, "description": "Optional phone or WhatsApp number." },
        "planType": { "type": "string", "maxLength": 80, "description": "Selected free business use case." },
        "tokensGranted": { "type": "number", "description": "Number of subscription tokens granted upon registration." },
        "priceLabel": { "type": "string", "maxLength": 30, "description": "Selected tier price label." },
        "targetUrl": { "type": "string", "maxLength": 200, "description": "Destination URL (https://whop.com/@saulmente)." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of registration." }
      },
      "required": ["name", "email", "targetUrl", "createdAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User subscription preferences, real PayPal payment records, and token credit package granted to use the program.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the subscription record." },
        "userId": { "type": "string", "description": "UID of the subscriber." },
        "subscriberName": { "type": "string", "maxLength": 120, "description": "Name of the subscriber." },
        "subscriberEmail": { "type": "string", "maxLength": 256, "description": "Email of the subscriber." },
        "packageId": { "type": "string", "maxLength": 60, "description": "Selected token package ID (tier-5, tier-10, tier-25, tier-50, free-welcome)." },
        "priceUsd": { "type": "number", "description": "Subscription package price in USD." },
        "priceLabel": { "type": "string", "maxLength": 40, "description": "Formatted price label ($5.00, $10.00, $25.00, $50.00)." },
        "tokensGranted": { "type": "number", "description": "Tokens/credits granted to use the program (62500, 125000, 312500, 625000)." },
        "status": { "type": "string", "enum": ["active", "paused"], "description": "Subscription status." },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual", "one_time"], "description": "Billing cycle preference." },
        "pricingMode": { "type": "string", "enum": ["single", "single_all", "per_category"], "description": "Pricing mode preference." },
        "categories": { "type": "array", "description": "Preferred creative categories." },
        "deliveryFormats": { "type": "array", "description": "Preferred delivery formats (Canva, Figma, 3D Studio, MP4/MP3)." },
        "autoGrantCreditsOnSubscribe": { "type": "boolean", "description": "Automatically grant credits upon subscribing." },
        "autoTopUpLowBalance": { "type": "boolean", "description": "Auto top-up tokens when balance is low." },
        "autoRecharge": { "type": "boolean", "description": "Auto recharge tokens when balance is low." },
        "redirectToWhop": { "type": "boolean", "description": "Redirect to Whop on subscription checkout." },
        "targetUrl": { "type": "string", "maxLength": 200, "description": "Whop destination URL." },
        "paymentMethod": { "type": "string", "maxLength": 40, "description": "Payment method used (paypal_live, paypal_checkout, whop, free_grant)." },
        "paypalOrderId": { "type": "string", "maxLength": 120, "description": "PayPal Order or Capture Transaction ID." },
        "paypalPayerEmail": { "type": "string", "maxLength": 256, "description": "PayPal payer email address." },
        "paypalStatus": { "type": "string", "maxLength": 40, "description": "PayPal order status (COMPLETED, APPROVED, VERIFIED)." },
        "merchantPayPalEmail": { "type": "string", "maxLength": 256, "description": "Merchant PayPal account receiving the payment." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of subscription." }
      },
      "required": ["userId", "packageId", "tokensGranted", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document."
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Generated video document."
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Free business registration document directed to https://whop.com/@saulmente."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "User subscription preferences, PayPal payment records, and token credit grants."
    }
  }
}
