rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256;
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['userId', 'prompt', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'title', 'prompt', 'folder', 'script', 'scenes',
          'images', 'referenceImage', 'scene3dPreset',
          'status', 'videoData', 'mimeType', 'aspectRatio', 'duration',
          'createdAt', 'interactionId'
        ])
        && data.userId == request.auth.uid
        && data.prompt is string && data.prompt.size() <= 2000
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && (!('folder' in data) || (data.folder is string && data.folder.size() <= 100))
        && (!('script' in data) || (data.script is string && data.script.size() <= 10000))
        && (!('scenes' in data) || (data.scenes is list && data.scenes.size() <= 50))
        && (!('images' in data) || (data.images is list && data.images.size() <= 20))
        && (!('referenceImage' in data) || (data.referenceImage is string && data.referenceImage.size() <= 800000))
        && (!('scene3dPreset' in data) || (data.scene3dPreset is string && data.scene3dPreset.size() <= 50))
        && (!('videoData' in data) || (data.videoData is string && data.videoData.size() <= 900000))
        && (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 100))
        && (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 20))
        && (!('duration' in data) || (data.duration is string && data.duration.size() <= 20))
        && data.status in ['pending', 'completed', 'failed'];
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'garciasaul501@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['name', 'email', 'targetUrl', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'email', 'businessName', 'phone', 'planType',
          'tokensGranted', 'priceLabel', 'targetUrl', 'createdAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && data.targetUrl == 'https://whop.com/@saulmente'
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 160))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 60))
        && (!('planType' in data) || (data.planType is string && data.planType.size() <= 80))
        && (!('tokensGranted' in data) || (data.tokensGranted is int || data.tokensGranted is float))
        && (!('priceLabel' in data) || (data.priceLabel is string && data.priceLabel.size() <= 30));
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['userId', 'packageId', 'tokensGranted', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'subscriberName', 'subscriberEmail', 'packageId',
          'priceUsd', 'priceLabel', 'tokensGranted', 'status', 'billingCycle',
          'pricingMode', 'categories', 'deliveryFormats',
          'autoGrantCreditsOnSubscribe', 'autoTopUpLowBalance', 'autoRecharge',
          'redirectToWhop', 'targetUrl', 'paymentMethod', 'paypalOrderId',
          'paypalPayerEmail', 'paypalStatus', 'merchantPayPalEmail', 'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.packageId is string && data.packageId.size() >= 1 && data.packageId.size() <= 60
        && (data.tokensGranted is int || data.tokensGranted is float)
        && data.tokensGranted >= 0 && data.tokensGranted <= 10000000
        && data.status in ['active', 'paused']
        && (!('subscriberName' in data) || (data.subscriberName is string && data.subscriberName.size() <= 120))
        && (!('subscriberEmail' in data) || (data.subscriberEmail is string && data.subscriberEmail.size() <= 256))
        && (!('priceUsd' in data) || (data.priceUsd is int || data.priceUsd is float))
        && (!('priceLabel' in data) || (data.priceLabel is string && data.priceLabel.size() <= 40))
        && (!('billingCycle' in data) || data.billingCycle in ['monthly', 'annual', 'one_time'])
        && (!('pricingMode' in data) || data.pricingMode in ['single', 'single_all', 'per_category'])
        && (!('categories' in data) || (data.categories is list && data.categories.size() <= 12))
        && (!('deliveryFormats' in data) || (data.deliveryFormats is list && data.deliveryFormats.size() <= 12))
        && (!('autoGrantCreditsOnSubscribe' in data) || data.autoGrantCreditsOnSubscribe is bool)
        && (!('autoTopUpLowBalance' in data) || data.autoTopUpLowBalance is bool)
        && (!('autoRecharge' in data) || data.autoRecharge is bool)
        && (!('redirectToWhop' in data) || data.redirectToWhop is bool)
        && (!('targetUrl' in data) || (data.targetUrl is string && data.targetUrl.size() <= 200))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 40))
        && (!('paypalOrderId' in data) || (data.paypalOrderId is string && data.paypalOrderId.size() <= 120))
        && (!('paypalPayerEmail' in data) || (data.paypalPayerEmail is string && data.paypalPayerEmail.size() <= 256))
        && (!('paypalStatus' in data) || (data.paypalStatus is string && data.paypalStatus.size() <= 40))
        && (!('merchantPayPalEmail' in data) || (data.merchantPayPalEmail is string && data.merchantPayPalEmail.size() <= 256));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /videos/{videoId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidVideo(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidVideo(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'folder', 'title', 'status', 'videoData', 'mimeType', 'aspectRatio', 'duration',
          'script', 'scenes', 'images', 'referenceImage', 'scene3dPreset'
        ]);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /registrations/{registrationId} {
      allow list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidRegistration(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /subscriptions/{subscriptionId} {
      allow list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidSubscription(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && isValidSubscription(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'billingCycle', 'pricingMode', 'categories', 'deliveryFormats',
          'autoGrantCreditsOnSubscribe', 'autoTopUpLowBalance', 'autoRecharge',
          'redirectToWhop', 'packageId', 'priceUsd', 'priceLabel', 'tokensGranted',
          'paymentMethod', 'paypalOrderId', 'paypalPayerEmail', 'paypalStatus',
          'merchantPayPalEmail'
        ]);
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
